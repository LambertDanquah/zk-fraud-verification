{"noir_version":"1.0.0-beta.22+c57152f91260ecdb9faad4efc20abb14b6d2ece7","hash":"16782330651378525052","abi":{"parameters":[{"name":"x","type":{"kind":"array","length":29,"type":{"kind":"field"}},"visibility":"private"},{"name":"W1","type":{"kind":"array","length":32,"type":{"kind":"array","length":29,"type":{"kind":"field"}}},"visibility":"private"},{"name":"b1","type":{"kind":"array","length":32,"type":{"kind":"field"}},"visibility":"private"},{"name":"W2","type":{"kind":"array","length":16,"type":{"kind":"array","length":32,"type":{"kind":"field"}}},"visibility":"private"},{"name":"b2","type":{"kind":"array","length":16,"type":{"kind":"field"}},"visibility":"private"},{"name":"W3","type":{"kind":"array","length":1,"type":{"kind":"array","length":16,"type":{"kind":"field"}}},"visibility":"private"},{"name":"b3","type":{"kind":"array","length":1,"type":{"kind":"field"}},"visibility":"private"},{"name":"claimed","type":{"kind":"array","length":1,"type":{"kind":"field"}},"visibility":"private"}],"return_type":null,"error_types":{}},"bytecode":"","debug_symbols":"","file_map":{"51":{"source":"use crate::neuron;\n\n\n\n// =============================\n// Layer: 29 → 32\n// =============================\n\npub fn dense_29_32(\n    x: [Field;29],\n    W: [[Field;29];32],\n    b: [Field;32]\n) -> [Field;32] {\n\n\n    let mut outputs = [0;32];\n\n\n    for n in 0..32 {\n\n        outputs[n] = neuron::compute_29(\n            x,\n            W[n],\n            b[n]\n        );\n\n    }\n\n\n    outputs\n}\n\n\n\n// =============================\n// Layer: 32 → 16\n// =============================\n\npub fn dense_32_16(\n    x: [Field;32],\n    W: [[Field;32];16],\n    b: [Field;16]\n) -> [Field;16] {\n\n\n    let mut outputs = [0;16];\n\n\n    for n in 0..16 {\n\n        outputs[n] = neuron::compute_32(\n            x,\n            W[n],\n            b[n]\n        );\n\n    }\n\n\n    outputs\n}\n\n\n\n// =============================\n// Layer: 16 → 1\n// =============================\n\npub fn dense_16_1(\n    x: [Field;16],\n    W: [[Field;16];1],\n    b: [Field;1]\n) -> [Field;1] {\n\n\n    let mut outputs = [0;1];\n\n\n    for n in 0..1 {\n\n        outputs[n] = neuron::compute_16(\n            x,\n            W[n],\n            b[n]\n        );\n\n    }\n\n\n    outputs\n}","path":"/workspaces/zk-fraud-verification/noir/fraud_mlp_verifier/src/layer.nr","function_locations":[{"start":206,"name":"dense_29_32"},{"start":576,"name":"dense_32_16"},{"start":941,"name":"dense_16_1"}]},"52":{"source":"mod neuron;\nmod layer;\n\n\n\nfn main(\n\n    x: [Field;29],\n\n    W1: [[Field;29];32],\n    b1: [Field;32],\n\n    W2: [[Field;32];16],\n    b2: [Field;16],\n\n    W3: [[Field;16];1],\n    b3: [Field;1],\n\n    claimed: [Field;1]\n\n) {\n\n\n    let h1 = layer::dense_29_32(\n        x,\n        W1,\n        b1\n    );\n\n\n    let h2 = layer::dense_32_16(\n        h1,\n        W2,\n        b2\n    );\n\n\n    let output = layer::dense_16_1(\n        h2,\n        W3,\n        b3\n    );\n\n\n    assert(\n        output[0] == claimed[0]\n    );\n\n}","path":"/workspaces/zk-fraud-verification/noir/fraud_mlp_verifier/src/main.nr","function_locations":[{"start":218,"name":"main"}]},"53":{"source":"pub fn compute_29(\n    x: [Field; 29],\n    w: [Field; 29],\n    b: Field\n) -> Field {\n\n    let mut result = b;\n\n    for i in 0..29 {\n\n        result += x[i] * w[i];\n\n    }\n\n    result\n}\n\n\n\npub fn compute_32(\n    x: [Field; 32],\n    w: [Field; 32],\n    b: Field\n) -> Field {\n\n    let mut result = b;\n\n    for i in 0..32 {\n\n        result += x[i] * w[i];\n\n    }\n\n    result\n}\n\n\n\npub fn compute_16(\n    x: [Field; 16],\n    w: [Field; 16],\n    b: Field\n) -> Field {\n\n    let mut result = b;\n\n    for i in 0..16 {\n\n        result += x[i] * w[i];\n\n    }\n\n    result\n}","path":"/workspaces/zk-fraud-verification/noir/fraud_mlp_verifier/src/neuron.nr","function_locations":[{"start":83,"name":"compute_29"},{"sta